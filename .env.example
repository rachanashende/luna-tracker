# Copy this to .env.local for local dev, and set the same values as
# variables/secrets in your Cloudflare Workers project for production
# (NEXT_PUBLIC_ values must also be set as build variables). For local
# Workers dev, the same values go in .dev.vars (gitignored).

# --- Supabase (Module 1) ---
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never exposed to the browser.
# Keep this out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (multi-user) ---
# Accounts are handled by Supabase Auth (email + password). Sign-up is gated
# by this invite code — share it only with people you want to let in.
# Server-side secret; sign-up refuses everyone if it's unset.
INVITE_CODE=

# --- Gemini (Module 7) ---
# Not needed until Module 7, but listed here since it lives in the same
# env file. Get a free-tier key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
