# Copy this to .env.local for local dev, and set the same values as
# Environment Variables in your Vercel project for production.

# --- Supabase (Module 1) ---
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never exposed to the browser.
# Keep this out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (Module 1) ---
# The single shared password for the login gate.
APP_PASSWORD=
# Any long random string — used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# --- Gemini (Module 7) ---
# Not needed until Module 7, but listed here since it lives in the same
# env file. Get a free-tier key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
